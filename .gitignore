.env
.venv/
__pycache__/
ocr_gold/runs/

# source documents -- kept outside version control
data/raw/
*.pdf
*.docx
# ...except blank forms the app offers for download (e.g. the travelling
# bill in the FAQ). A form carries no manual text.
!assets/forms/*.pdf

# generated artefacts: all regenerable from data/raw + the scripts, and they
# change on every pipeline run. ~15MB if tracked.
data/processed/*
# ...except the chunk manifest. gold/ cites chunk_ids and data/processed is
# not tracked, so without this a clone cannot verify a single source_ref.
# It carries ids, shas and headings only -- no body, so the manuals stay out.
!data/processed/chunk_manifest.json
out/
check_*.html
headings_*.md
audit_*.csv
bucket_*.json

# the quiz build's record of what it sent the model: the FULL TEXT of the
# manual chunks it used. Manual bodies stay out of git (see data/processed
# above), and the data-protection decision is still pending.
quiz/_sent_to_model.jsonl

# full-size photo originals: large, and the app serves the web versions in
# assets/ (e.g. assets/brac-members.webp), which ARE tracked.
assets/originals/
