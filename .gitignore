.env
.venv/
__pycache__/
ocr_gold/runs/

# source documents -- kept outside version control
data/raw/
*.pdf
*.docx

# generated artefacts: all regenerable from data/raw + the scripts, and they
# change on every pipeline run. ~15MB if tracked.
data/processed/*
# ...except the chunk manifest. gold/ cites chunk_ids and data/processed is
# not tracked, so without this a clone cannot verify a single source_ref.
# It carries ids, shas and headings only -- no body, so the manuals stay out.
!data/processed/chunk_manifest.json
out/
check_*.html
headings_*.md
audit_*.csv
bucket_*.json
